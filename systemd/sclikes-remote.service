[Unit]
Description=sclikes: remote control for another machine's player (ssh bridge; the other machine plays)
# Only one sclikes backend at a time: starting this stops the local player, and waits for it to exit.
Conflicts=sclikes.service
After=sclikes.service network-online.target graphical-session.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/sclikes remote
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
